  `,k=`
    #pgz-banner { display: none; }

    @media (min-width: ${c}px) {
      #pgz-banner { position: fixed; top: 0; left: 0; right: 0; height: ${o}px;
        z-index: 2147483000; box-sizing: border-box; display: flex;
        align-items: center; justify-content: center;
        padding: 0 100px;
        background: #CCEDFF;
        color: #25265E; font-family: "Euclid Circular A", "Euclid Circular A Medium", system-ui, sans-serif;
        overflow: hidden; }
      #pgz-content { position: relative; display: flex; align-items: center;
        gap: 48px; max-width: 1110px; padding-left: 64px; }
      #pgz-person { position: absolute; left: -36px; top: -14px; width: 107px; height: 78px;
        display: block; pointer-events: none; }
      #pgz-squiggle { position: absolute; left: 30.17px; top: -11.13px;
        display: block; pointer-events: none; }
      #pgz-msg { margin: 0; font-size: 18px; font-weight: 500; line-height: 22.5px; }
      #pgz-cta { display: inline-flex; align-items: center; gap: 8px; height: 48px;
        box-sizing: border-box; background: #0556F3; color: #FFFFFF; font-weight: 700;
        font-size: 16px; line-height: 24px; padding: 12px 16px 12px 20px;
        border-radius: 4px; text-decoration: none; white-space: nowrap;
        transition: background-color 150ms ease; }
      #pgz-cta:hover { background: #0047D1; }
      #pgz-cta svg { display: block; flex: none; }
      #pgz-close { position: absolute; top: 8px; right: 12px; background: none; border: 0;
        color: #25265E; font-size: 22px; line-height: 1; cursor: pointer; opacity: .6; padding: 4px; }
      #pgz-close:hover { opacity: 1; }
      body { padding-top: ${o}px !important; }
    }
